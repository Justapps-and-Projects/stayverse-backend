# Shared template — set EXPO_PUBLIC_APP_TARGET per app (user|agent) in app.config.js.

APP_ENV=development
EXPO_PUBLIC_API_BASE_URL=https://stayverse-backend-lzlu.onrender.com
EXPO_PUBLIC_SOCKET_URL=https://stayverse-backend-lzlu.onrender.com
EXPO_PUBLIC_GOOGLE_API_KEY=
# Optional native Maps SDK key (agent Flutter used a separate native key).
# Falls back to EXPO_PUBLIC_GOOGLE_API_KEY when empty.
EXPO_PUBLIC_GOOGLE_MAPS_SDK_KEY=
EXPO_PUBLIC_GET_STREAM_KEY=
# Flutter env key is misspelled `SENTRY_DNS` — copy that value here.
EXPO_PUBLIC_SENTRY_DSN=
# Optional — EAS secret for source map upload during native builds
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
