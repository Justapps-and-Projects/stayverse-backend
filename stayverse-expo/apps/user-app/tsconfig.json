{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./*"
      ],
      "@stayverse/core": [
        "../../packages/core/src/index.ts"
      ],
      "@stayverse/ui": [
        "../../packages/ui/src/index.tsx"
      ],
