#APP CONFIGURATIONS
APP_NAME=stayverse
APP_VERSION=1.0
APP_DESCRIPTION="Stayverse is a tri-functional application rendering services like apartments rides and chefs"
BASE_URL=http://localhost:3000

JWT_SECRET=your_jwt_secret_key

# DATABASE
DATABASE_URL=mongodb://localhost:27017/your_database_name

# MAIL CONFIGURATIONS
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=your_mail_username
MAIL_PASS=your_mail_password
MAIL_FROM=no-reply@example.com
MAIL_TIMEOUT_MS=15000
# Optional: Brevo (Sendinblue) HTTP API — preferred on Render when SMTP is unreliable
BREVO_API_KEY=
RESEND_API_KEY=
# Internal testing only: log OTP to server logs when SMTP/Brevo/Resend is unavailable
MAIL_LOG_OTP_FALLBACK=false

#GOOGLE CLOUD PLATFORM
GCP_PROJECT_ID=your-google-id
GCP_KEY_FILE=your-private-key
GCP_BUCKET_NAME=your-bucket

#GOOGLE MAPS KEY
GOOGLE_MAPS_API_KEY=your_google_map_key


# Disable on replacement services until scheduled-job ownership is transferred.
ENABLE_SCHEDULED_JOBS=true

# Optional Supabase S3 storage. S3 credentials belong only on the backend.
STORAGE_PROVIDER=digitalocean
SUPABASE_URL=
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_STORAGE_BUCKET=stayverse-media
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
